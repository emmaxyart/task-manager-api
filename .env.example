# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/task_manager?schema=public"

# Port the API listens on.
PORT=3000

# Comma-separated list of frontend origins allowed by CORS.
# Multiple example: http://localhost:5173,http://localhost:3001
# Use * to allow any origin (development only).
CLIENT_URL=http://localhost:5173

# development | production. In production, CORS allows nothing unless
# CLIENT_URL is explicitly set.
NODE_ENV=development
